      "source": [
        "# Evaluate uplift predictions separately\n",
        "\n",
        "def evaluate_uplift(data, name):\n",
        "\n",
        "    data = data.copy()\n",
        "\n",
        "    data = data.sort_values(\n",
        "        'uplift_score',\n",
        "        ascending=False\n",
        "    ).reset_index(drop=True)\n",
        "\n",
        "    data['targeted_fraction'] = (\n",
        "        np.arange(1, len(data) + 1) / len(data)\n",
        "    )\n",
        "\n",
        "    data['cumulative_uplift'] = (\n",
        "        data['uplift_score'].cumsum()\n",
        "        / np.arange(1, len(data) + 1)\n",
        "    )\n",
        "\n",
        "    print(f\"\\n{name}\")\n",
        "    print(\"Average predicted uplift:\",\n",
        "          round(data['uplift_score'].mean(), 5))\n",
        "\n",
        "    return data\n",
        "\n",
        "\n",
        "eval_low = evaluate_uplift(test_low, \"Low-tier: T1L vs CGL\")\n",
        "\n",
        "eval_high_t1 = evaluate_uplift(\n",
        "    test_high_t1, \"High-tier T1: T1H vs CGH\"\n",
        ")\n",
        "\n",
        "eval_high_t2 = evaluate_uplift(\n",
        "    test_high_t2, \"High-tier T2: T2H vs CGH\"\n",
        ")\n",
        "\n",
        "# Plot uplift curves\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    eval_low['targeted_fraction'],\n",
        "    eval_low['cumulative_uplift'],\n",
        "    label='Low-tier'\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    eval_high_t1['targeted_fraction'],\n",
        "    eval_high_t1['cumulative_uplift'],\n",
        "    label='High-tier T1'\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    eval_high_t2['targeted_fraction'],\n",
        "    eval_high_t2['cumulative_uplift'],\n",
        "    label='High-tier T2'\n",
        ")\n",
        "\n",
        "plt.axhline(0, linestyle='--', color='black')\n",
        "\n",
        "plt.xlabel(\"Fraction of customers targeted\")\n",
        "plt.ylabel(\"Mean predicted uplift\")\n",
        "plt.title(\"Predicted Uplift by Customer Targeting Fraction\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()"
