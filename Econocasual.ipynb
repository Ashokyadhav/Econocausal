    {
      "cell_type": "markdown",
      "metadata": {
        "id": "eb6a61c9"
      },
      "source": [
        "# 6. Uplift Modelling\n",
        "\n",
        "group_summary = df.groupby(\"group\").agg(\n",
        "    customers=(\"consumer_id\", \"count\"),\n",
        "    purchase_rate=(\"purchase\", \"mean\"),\n",
        "    visit_rate=(\"visit\", \"mean\"),\n",
        "    redemption_rate=(\"redeem\", \"mean\")\n",
        ")\n",
        "\n",
        "# Average purchase amount among customers who purchased\n",
        "purchase_amount = (\n",
        "    df[df[\"purchase\"] == 1]\n",
        "    .groupby(\"group\")[\"amount\"]\n",
        "    .mean()\n",
        ")\n",
        "\n",
        "group_summary[\"avg_purchase_amount\"] = purchase_amount\n",
        "\n",
        "print(group_summary.round(3))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "VhfJ6w2WaD5P",
        "outputId": "8b4c3618-60e8-4432-b4b4-273c5c791ca5"
      },
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "       customers  purchase_rate  visit_rate  redemption_rate  \\\n",
            "group                                                          \n",
            "CGH          801          0.042       0.227            0.000   \n",
            "CGL         1998          0.010       0.106            0.000   \n",
            "T1H         1927          0.066       0.446            0.008   \n",
            "T1L         4787          0.026       0.346            0.005   \n",
