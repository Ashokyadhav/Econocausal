            "Target All / Random Strategy:\n",
            "  - Customers targeted: 1000\n",
            "  - Expected incremental purchases: 10.02\n",
            "  - Cost per incremental purchase: $99.76\n",
            "\n",
            "Uplift-Optimized Strategy:\n",
            "  - Customers targeted: 1000\n",
            "  - Expected incremental purchases: 20.52\n",
            "  - Cost per incremental purchase: $48.74\n",
            "  - Efficiency improvement: 104.7%\n",
            "============================================================\n",
            "\n",
            "=== Budget Optimization Results for High-Tier (Budget: $1500.0) ===\n",
            "Target All / Random Strategy:\n",
            "  - Customers targeted: 300\n",
            "  - Expected incremental purchases: 3.22\n",
            "  - Cost per incremental purchase: $465.84\n",
            "\n",
            "Uplift-Optimized Strategy:\n",
            "  - Customers targeted: 300\n",
            "  - Expected incremental purchases: 20.25\n",
