      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Set style\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "# Prepare data for plotting by resetting index of group_summary\n",
        "plot_data = group_summary.reset_index()\n",
        "\n",
        "# Set up the plotting area\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "\n",
        "# 1. Purchase Rate by Group\n",
        "sns.barplot(x=\"group\", y=\"purchase_rate\", data=plot_data, ax=axes[0], palette=\"Blues_d\", hue=\"group\", legend=False)\n",
        "axes[0].set_title(\"Purchase Rate by Group\")\n",
        "axes[0].set_xlabel(\"Experimental Group\")\n",
        "axes[0].set_ylabel(\"Mean Purchase Rate\")\n",
        "\n",
        "# 2. Visit Rate by Group\n",
        "sns.barplot(x=\"group\", y=\"visit_rate\", data=plot_data, ax=axes[1], palette=\"Greens_d\", hue=\"group\", legend=False)\n",
        "axes[1].set_title(\"Website Visit Rate by Group\")\n",
        "axes[1].set_xlabel(\"Experimental Group\")\n",
        "axes[1].set_ylabel(\"Mean Visit Rate\")\n",
        "\n",
        "# 3. Redemption Rate by Group\n",
        "sns.barplot(x=\"group\", y=\"redemption_rate\", data=plot_data, ax=axes[2], palette=\"Oranges_d\", hue=\"group\", legend=False)\n",
        "axes[2].set_title(\"Coupon Redemption Rate by Group\")\n",
        "axes[2].set_xlabel(\"Experimental Group\")\n",
        "axes[2].set_ylabel(\"Mean Redemption Rate\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "execution_count": 9,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 275
        },
        "id": "4d7d3fae",
        "outputId": "ffc90173-88ff-4982-942e-7b7146e9f9d2"
      },
      "source": [
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "features = ['pageviews', 'visit']\n",
        "\n",
        "def train_t_learner(df_tier):\n",
        "    # Split into train and test sets to maintain a proper validation routine\n",
        "    train_df, test_df = train_test_split(df_tier, test_size=0.3, random_state=42, stratify=df_tier['group'])\n",
        "\n",
        "    # Separate control and treatment subsets within the train set\n",
        "    control_train = train_df[train_df['treatment'] == 0]\n",
        "    treatment_train = train_df[train_df['treatment'] == 1]\n",
        "\n",
        "    # Instantiate models\n",
        "    model_ctrl = LogisticRegression(random_state=42)\n",
        "    model_trt = LogisticRegression(random_state=42)\n",
        "\n",
        "    # Train\n",
        "    model_ctrl.fit(control_train[features], control_train['purchase'])\n",
        "    model_trt.fit(treatment_train[features], treatment_train['purchase'])\n",
        "\n",
        "    # Predict probabilities on the test set\n",
        "    p_control = model_ctrl.predict_proba(test_df[features])[:, 1]\n",
        "    p_treatment = model_trt.predict_proba(test_df[features])[:, 1]\n",
        "\n",
        "    # Calculate uplift score\n",
        "    test_df = test_df.copy()\n",
        "    test_df['p_control'] = p_control\n",
        "    test_df['p_treatment'] = p_treatment\n",
        "    test_df['uplift_score'] = p_treatment - p_control\n",
        "\n",
        "    return test_df, model_ctrl, model_trt\n",
        "\n",
        "print(\"Training Low-Tier Uplift Models...\")\n",
        "test_low, model_ctrl_low, model_trt_low = train_t_learner(df_low)\n",
        "\n",
        "print(\"Training High-Tier Uplift Models...\")\n",
        "test_high, model_ctrl_high, model_trt_high = train_t_learner(df_high)\n",
        "\n",
        "print(\"\\nUplift scoring complete! Sample scores from the Low-Tier test set:\")\n",
        "display(test_low[['group', 'purchase', 'p_control', 'p_treatment', 'uplift_score']].head())"
      ],
