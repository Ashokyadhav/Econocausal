      "source": [
        "# 10. Visualizations\n",
        "\n",
        "We will visualize the results of our budget optimization to make the business case clear for stakeholders. This plot contrasts the expected incremental purchases achieved using the **Uplift-Optimized Strategy** versus the **Target All / Random Strategy** for both the Low-Tier and High-Tier groups under their respective budgets."
      ]
    },
    {
      "cell_type": "code",
      "source": [],
      "metadata": {
        "id": "qx3MSF59BF1u"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "features = ['pageviews', 'visit']\n",
        "\n",
        "def train_t_learner(data):\n",
        "\n",
        "    train_df, test_df = train_test_split(\n",
        "        data,\n",
        "        test_size=0.30,\n",
        "        random_state=42,\n",
        "        stratify=data['group']\n",
        "    )\n",
        "\n",
        "    control_train = train_df[train_df['treatment'] == 0]\n",
        "    treatment_train = train_df[train_df['treatment'] == 1]\n",
        "\n",
        "    model_control = LogisticRegression(\n",
        "        max_iter=1000,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    model_treatment = LogisticRegression(\n",
        "        max_iter=1000,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    model_control.fit(\n",
        "        control_train[features],\n",
        "        control_train['purchase']\n",
        "    )\n",
        "\n",
        "    model_treatment.fit(\n",
        "        treatment_train[features],\n",
        "        treatment_train['purchase']\n",
        "    )\n",
        "\n",
        "    test_df = test_df.copy()\n",
        "\n",
        "    test_df['p_control'] = model_control.predict_proba(\n",
        "        test_df[features]\n",
        "    )[:, 1]\n",
        "\n",
        "    test_df['p_treatment'] = model_treatment.predict_proba(\n",
        "        test_df[features]\n",
        "    )[:, 1]\n",
        "\n",
        "    test_df['uplift_score'] = (\n",
        "        test_df['p_treatment'] - test_df['p_control']\n",
        "    )\n",
        "\n",
        "    return test_df, model_control, model_treatment\n",
        "\n",
        "\n",
        "# Train three separate models\n",
        "\n",
        "test_low, model_ctrl_low, model_trt_low = train_t_learner(df_low)\n",
        "\n",
        "test_high_t1, model_ctrl_t1, model_trt_t1 = train_t_learner(df_high_t1)\n",
        "\n",
        "test_high_t2, model_ctrl_t2, model_trt_t2 = train_t_learner(df_high_t2)\n",
        "\n",
        "print(\"All three T-Learner models trained successfully!\")\n",
        "\n",
        "display(test_low.head())\n",
        "display(test_high_t1.head())\n",
        "display(test_high_t2.head())"
      ],
