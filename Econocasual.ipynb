    {
      "cell_type": "code",
      "source": [
        "# Budget Optimization using predicted uplift\n",
        "\n",
        "# Train T-Learners for individual high-tier comparisons to define the missing variables\n",
        "test_high_t1, _, _ = train_t_learner(df_high_t1)\n",
        "test_high_t2, _, _ = train_t_learner(df_high_t2)\n",
        "\n",
        "budget = 1000\n",
        "cost_per_coupon = 1\n",
        "\n",
        "def optimize_budget(data, name):\n",
        "    data = data.copy()\n",
        "\n",
        "    # Keep customers with positive predicted uplift\n",
        "    data = data[data['uplift_score'] > 0].copy()\n",
        "\n",
        "    # Rank customers by predicted uplift\n",
        "    data = data.sort_values(\n",
        "        'uplift_score',\n",
        "        ascending=False\n",
        "    )\n",
        "\n",
        "    # Calculate maximum customers affordable\n",
        "    max_customers = int(budget // cost_per_coupon)\n",
        "\n",
        "    # Select customers within budget\n",
        "    selected = data.head(max_customers).copy()\n",
        "\n",
        "    selected['expected_incremental_purchases'] = (\n",
        "        selected['uplift_score']\n",
        "    )\n",
        "\n",
        "    total_customers = len(selected)\n",
        "\n",
        "    expected_incremental_purchases = (\n",
        "        selected['expected_incremental_purchases'].sum()\n",
        "    )\n",
        "\n",
        "    total_cost = total_customers * cost_per_coupon\n",
        "\n",
        "    efficiency = (\n",
        "        expected_incremental_purchases / total_cost\n",
        "        if total_cost > 0 else 0\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        'Comparison': name,\n",
        "        'Customers targeted': total_customers,\n",
        "        'Total budget used': total_cost,\n",
        "        'Expected incremental purchases': expected_incremental_purchases,\n",
        "        'Expected purchases per budget unit': efficiency\n",
        "    }\n",
        "\n",
        "# Optimize all three comparisons\n",
        "results = [\n",
        "    optimize_budget(test_low, 'Low-tier'),\n",
        "    optimize_budget(test_high_t1, 'High-tier T1'),\n",
        "    optimize_budget(test_high_t2, 'High-tier T2')\n",
        "]\n",
        "\n",
        "budget_results = pd.DataFrame(results)\n",
        "display(budget_results)"
      ],
